rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedInMember(conversationId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.participants.hasAny([request.auth.uid]);
    }

    match /conversations/{conversationId}/{userId}/{fileName} {
      allow read: if signedInMember(conversationId);
      allow create: if signedInMember(conversationId)
        && request.auth.uid == userId
        && (
          request.resource.contentType.matches('image/.*')
          && request.resource.size <= 15 * 1024 * 1024
          || request.resource.contentType.matches('video/.*')
          && request.resource.size <= 50 * 1024 * 1024
        );
      allow update, delete: if false;
    }
  }
}
