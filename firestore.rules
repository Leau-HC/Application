rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function authenticated() {
      return request.auth != null;
    }

    function isMember(conversationId) {
      return signedIn()
        && get(/databases/$(database)/documents/conversations/$(conversationId))
          .data.participants.hasAny([request.auth.uid]);
    }

    function hasConversationWith(userId) {
      let conversationId = request.auth.uid < userId
        ? request.auth.uid + '__' + userId
        : userId + '__' + request.auth.uid;
      return exists(/databases/$(database)/documents/conversations/$(conversationId));
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId || hasConversationWith(userId));
      allow list: if false;
      allow create: if authenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || resource.data.participants.hasAny([request.auth.uid])
        );
      allow list: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participants', 'createdAt', 'updatedAt', 'lastMessage'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.participants.hasAny([request.auth.uid])
        && conversationId == (
          request.resource.data.participants[0] < request.resource.data.participants[1]
            ? request.resource.data.participants[0] + '__'
              + request.resource.data.participants[1]
            : request.resource.data.participants[1] + '__'
              + request.resource.data.participants[0]
        )
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1]))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000;
      allow update: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        function validMessage() {
          return request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt'])
            && request.resource.data.keys().hasOnly([
              'senderId', 'text', 'createdAt', 'mediaPath', 'mediaType'
            ])
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 5000
            && request.resource.data.createdAt == request.time
            && (
              !('mediaPath' in request.resource.data)
              && !('mediaType' in request.resource.data)
              || (
                request.resource.data.mediaPath is string
                && request.resource.data.mediaPath.matches(
                  'conversations/' + conversationId + '/' + request.auth.uid + '/[^/]+'
                )
                && request.resource.data.mediaType in ['image', 'video']
                && (request.resource.data.text.size() > 0
                  || request.resource.data.mediaPath.size() > 0)
              )
            );
        }

        allow read: if isMember(conversationId);
        allow create: if isMember(conversationId) && validMessage();
        allow update, delete: if false;
      }
    }
  }
}
